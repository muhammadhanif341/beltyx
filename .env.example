# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never exposed to the browser, never prefixed with NEXT_PUBLIC_.
# Used for admin operations that must bypass RLS (product image uploads, etc).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for absolute links (order emails, sitemap, etc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — shows the floating WhatsApp support button (digits only, with country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional — payment gateways beyond COD / Bank Transfer / the built-in test
# card. Each gateway only appears at checkout once its variables are set.
# See src/lib/payments/ to wire up the real API calls when credentials arrive.
STRIPE_SECRET_KEY=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
